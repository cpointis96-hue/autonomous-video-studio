{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Video Studio timeline",
  "type": "object",
  "required": ["schema_version", "project", "clips"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "project": {"type": "string", "minLength": 1},
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "in", "out"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "in": {"type": "number", "minimum": 0},
          "out": {"type": "number", "exclusiveMinimum": 0},
          "timeline_start": {"type": "number", "minimum": 0},
          "crop": {"type": "object"},
          "zoom": {"type": "number", "minimum": 0.1},
          "transition": {"type": "string"},
          "audio": {"type": "object"},
          "text": {"type": "string"},
          "broll_source": {"type": "string"},
          "overlay_audio_from_main": {"type": "boolean"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
